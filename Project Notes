Docker Compose file

version: "3.8"

services:                #We need to make containers for Django, mysql and nginx
  nginx:                 #Search nginx default config file on google, go to beginners link, search for proxy pass which will give code to be written
                         #config file in nginx/default.config. In that file, nginx server will listen at port 80. There is a line in 
                         # Dockerfile of Nginx - FROM nginx:1.23.3-alpine         this means the base image to be built from
                         #                       COPY ./default.conf /etc/nginx/conf.d/default.conf          this means to copy config file kept /etc/nginx/conf.d/default.conf (in the container) to ./default.conf which is our default.config file in nginx folder 

    build: ./nginx
    image: nginx
    container_name: "nginx_cont"
    ports:
      - "80:80"
    restart: always
    depends_on:
      - django_app
    networks:
      - notes-app-nw

  django_app:
    build:
      context: .
    image: django_app
    container_name: "django_cont"
    ports:
      - "8000:8000"
    command: sh -c "python manage.py migrate --noinput && gunicorn notesapp.wsgi --bind 0.0.0.0:8000"
    env_file:
      - ".env"
    depends_on:
      - db
    restart: always
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8000/admin || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - notes-app-nw

  db:
    image: mysql
    container_name: "db_cont"
    environment:
      - MYSQL_ROOT_PASSWORD=root
      - MYSQL_DATABASE=test_db
    volumes:
      - ./data/mysql/db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-proot"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - notes-app-nw

networks:
  notes-app-nw:
