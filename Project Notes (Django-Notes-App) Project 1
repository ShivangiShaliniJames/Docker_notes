version: "3.8"

services:                #We need to make containers for Django, mysql and nginx
  nginx:                 #Search nginx default config file on google, go to beginners link, search for proxy pass which will give code to be written
                         #config file in nginx/default.config. In that file, nginx server will listen at port 80. There is a line in 
                         # Dockerfile of Nginx - FROM nginx:1.23.3-alpine         this means the base image to be built from
                         #                       COPY ./default.conf /etc/nginx/conf.d/default.conf          this means to copy config file kept /etc/nginx/conf.d/default.conf (in the container) to ./default.conf which is our default.config file in nginx folder 

    build: ./nginx       #build means build nginx from dockerfile kept in the nginx folder
    image: nginx
    container_name: "nginx_cont"        #container name
    ports:
      - "80:80"                        #nginx runs on port 80
    restart: always                    #make sure nginx always restart if stopped
    depends_on:
      - django_app                    ##depends on django
    networks:
      - notes-app-nw

  django_app:
    build:
      context: .                    #image will be build from current which is .
    image: django_app
    container_name: "django_cont"  #mentioned django_container name in default.config file in nginx
    ports:
      - "8000:8000"                #port is 8000 mentioned in default.config file in nginx
    command: sh -c "python manage.py migrate --noinput && gunicorn notesapp.wsgi --bind 0.0.0.0:8000"                #check wsgi file in notesapp folder, using shell command, gunicorn serves your application in production, we have'nt mentioned RUN commands in Dockerfile in our application (last two lines), bind command allows the application to run on local host
    env_file:
      - ".env"                    #.env has all the environment variables
    depends_on:
      - db                        #depends on mysql
    restart: always               #make sure django always restart if stopped
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8000/admin || exit 1"]            #make sure that health of django app is met
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - notes-app-nw            # #network is notes-app-nw

  db:
    image: mysql                    #there is no dockerfile from which mysql will be built, so build from image mysql
    container_name: "db_cont"
    environment:
      - MYSQL_ROOT_PASSWORD=root      #mysql root password, check the .env file
      - MYSQL_DATABASE=test_db        #mysql database, check the .env file
    volumes:
      - ./data/mysql/db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-proot"]        #to make sure that db should run with multiple interval and timeout and retries
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - notes-app-nw                #network is notes-app-nw

networks:
  notes-app-nw:                    #declare network is notes-app-nw

